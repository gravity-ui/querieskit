  "scripts": {
    "build": "app-builder build",
    "lint": "eslint",
    "lint:all": "eslint \"./src/**/*.{js,jsx,ts,tsx}\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "npm run test:timezones && npm run test:components && npm run test:timeline && npm run test:charts && npm run test:editor-helpers && npm run test:parameters && npm run test:types",
    "test:charts": "vitest run tests/helpers/chartFieldsForm.test.ts tests/helpers/chartBindingsExamples.test.ts tests/helpers/chartLabels.test.ts",
    "test:timezones": "TZ=UTC vitest run tests/helpers/time.test.ts && TZ=Europe/Moscow vitest run tests/helpers/time.test.ts && TZ=Asia/Kolkata vitest run tests/helpers/time.test.ts && TZ=America/New_York vitest run tests/helpers/time.test.ts",
    "test:components": "vitest run tests/components",
    "prepublishOnly": "npm run build",
    "test:tree-shaking": "npm run build && node tests/tree-shaking/check.mjs",
    "test:timeline": "vitest run tests/helpers/queryTimeline.test.ts",
    "test:editor-helpers": "vitest run tests/helpers/editorProviders.test.ts tests/helpers/queryEditorPreset.test.ts",
    "test:editors:browser": "playwright test",
    "test:parameters": "vitest run tests/helpers/queryParameters.test.ts tests/helpers/parameterDate.test.ts",
    "test:types": "tsc -p tests/types",
    "test:page:browser": "playwright test tests/browser/queryPage.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/querieskit"
  },
  "keywords": [
